# Copy this file to .env and fill in your values.

# HTTP
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=runcount
DB_CONNECTION_LIMIT=10

# Database used by "npm test" (it is wiped on every test run)
TEST_DB_NAME=runcount_test

# Auth. Leave JWT_SECRET empty to auto-generate one into data/.jwt-secret
JWT_SECRET=
JWT_EXPIRES_IN=7d
ALLOW_REGISTRATION=true

# Address(es) of the Angular app allowed to call this API, comma-separated.
CORS_ORIGINS=http://localhost:4200
